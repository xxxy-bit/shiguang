<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="拾 光"
        android:textSize="28sp"
        android:textColor="#3D3226"
        android:fontFamily="serif"
        android:letterSpacing="0.15"
        android:layout_marginBottom="20dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/input_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="记下一句话…"
                android:maxLength="100"
                android:textColorHint="#B8AB9A"
                android:minHeight="72dp"
                android:gravity="top"
                android:textSize="15sp"
                android:textColor="#3D3226"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/char_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/100"
                android:textSize="11sp"
                android:textColor="#B8AB9A"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="保存"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C8945C" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="加载中..."
        android:textSize="12sp"
        android:textColor="#9B8E7E"
        android:layout_marginBottom="10dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:id="@+id/list_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="?android:attr/listDivider"
            android:showDividers="middle"
            android:padding="4dp" />
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小组件样式"
                android:textSize="15sp"
                android:textColor="#3D3226"
                android:fontFamily="serif"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/font_size_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字号: 17sp"
                android:textSize="13sp"
                android:textColor="#5C5044"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/font_size_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="30"
                android:thumbTint="#C8945C"
                android:progressTint="#C8945C"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/corner_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="圆角: 16dp"
                android:textSize="13sp"
                android:textColor="#5C5044"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/corner_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="40"
                android:thumbTint="#C8945C"
                android:progressTint="#C8945C"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="文字颜色"
                android:textSize="13sp"
                android:textColor="#5C5044"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/color_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_apply_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="应用到小组件"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C8945C" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
