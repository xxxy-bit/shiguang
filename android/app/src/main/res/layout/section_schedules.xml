<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="日 程"
        android:textSize="28sp"
        android:textColor="#3D3226"
        android:fontFamily="serif"
        android:letterSpacing="0.15"
        android:layout_marginBottom="20dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FEFAF3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <EditText
                android:id="@+id/sch_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="日程标题"
                android:textColorHint="#B8AB9A"
                android:textSize="15sp"
                android:textColor="#3D3226"
                android:singleLine="true"
                android:background="@android:color/transparent"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/sch_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="日期"
                    android:textColorHint="#B8AB9A"
                    android:focusable="false"
                    android:clickable="true"
                    android:textSize="14sp"
                    android:textColor="#3D3226"
                    android:singleLine="true"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:backgroundTint="#F5F0E8"
                    android:layout_marginEnd="8dp" />

                <EditText
                    android:id="@+id/sch_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="时间"
                    android:textColorHint="#B8AB9A"
                    android:focusable="false"
                    android:clickable="true"
                    android:textSize="14sp"
                    android:textColor="#3D3226"
                    android:singleLine="true"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:backgroundTint="#F5F0E8" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_sch_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="添加日程"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C8945C" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FEFAF3">

        <LinearLayout
            android:id="@+id/schedule_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="?android:attr/listDivider"
            android:showDividers="middle"
            android:padding="4dp" />
    </androidx.cardview.widget.CardView>
</LinearLayout>
