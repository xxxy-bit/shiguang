<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="设 置"
        android:textSize="28sp"
        android:textColor="#3D3226"
        android:fontFamily="serif"
        android:letterSpacing="0.15"
        android:layout_marginBottom="20dp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FEFAF3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小组件样式"
                android:textSize="15sp"
                android:textColor="#3D3226"
                android:fontFamily="serif"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/font_size_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字号: 17sp"
                android:textSize="13sp"
                android:textColor="#5C5044"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/font_size_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="30"
                android:thumbTint="#C8945C"
                android:progressTint="#C8945C"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/corner_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="圆角: 16dp"
                android:textSize="13sp"
                android:textColor="#5C5044"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/corner_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="40"
                android:thumbTint="#C8945C"
                android:progressTint="#C8945C"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="文字颜色"
                android:textSize="13sp"
                android:textColor="#5C5044"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/color_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btn_apply_style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="应用到小组件"
                android:textColor="#FFFFFF"
                android:backgroundTint="#C8945C" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FEFAF3">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自动轮播"
                android:textSize="15sp"
                android:textColor="#3D3226"
                android:fontFamily="serif"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/interval_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="关闭"
                android:textSize="16sp"
                android:textColor="#C8945C"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <SeekBar
                android:id="@+id/interval_seek"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="3"
                android:progress="0"
                android:thumbTint="#C8945C"
                android:progressTint="#C8945C" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>
